# ─────────────────────────────────────────────────────────────
# .gitignore — GitHub에 올라가면 안 되는 파일들
# ─────────────────────────────────────────────────────────────

# 환경변수 파일
.env
.env.*
*.env

# 서버 실행파일 및 로그
server/ngrok.exe
server/cloudflared.exe
server/cloudflared_url.log
server/warm_beta_cache.log
server/logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# RV Position 사용자 데이터 (private)
server/app/data/rv_positions.json
server/app/data/*.json

# Claude Code internal
.claude/

# 로컬 렌더링 산출물 (MD 원본만 추적)
*.pdf

# 루트 스크래치 (ripgrep 등 임시 산출 — publish="." 공개서빙 방지)
/_rg.json
/_*.json

# redesign-wb: 참고 사이트 원본 명세·화면 캡처는 로컬 기록만(공개 저장소·공개 사이트에 싣지 않음)
docs/design-wb/ref/

# 주간 리뷰 일반 보기 웹 검증 픽스처(prep_fixtures.py 산출 · 스냅샷 데이터 — 커밋·배포 금지)
tools/quant-house/_review_plain_check/_fx/
